# STORAGE
REDIS_URL="redis://127.0.0.1:6379"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
DATABASE_URL_DIRECT="$DATABASE_URL"
CLICKHOUSE_URL="http://localhost:8123/openpanel"

# Symmetric key used to encrypt TOTP secrets and other sensitive data at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# REST
BATCH_SIZE="5000"
BATCH_INTERVAL="10000"
CONCURRENCY="10"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3333"
WORKER_PORT=9999
API_PORT=3333

# REDPANDA (optional, runs in parallel with the groupmq events queue)
# Empty REDPANDA_BROKERS disables both producer and consumer; everything
# falls back to groupmq. Set REDPANDA_PROJECT_IDS=* to route all projects,
# or a comma-separated allow-list to route specific ones.
# REDPANDA_BROKERS=""
# REDPANDA_EVENTS_TOPIC="events"
# REDPANDA_CONSUMER_GROUP="openpanel-events"
# REDPANDA_PROJECT_IDS=""
# REDPANDA_PARTITIONS_CONCURRENT="8"
# Local dev with docker-compose:
# REDPANDA_BROKERS="localhost:19092"
# REDPANDA_PROJECT_IDS="*"

# EMAIL - set one or both; SMTP takes priority over Resend if SMTP_HOST is set
# Option A - Resend
# RESEND_API_KEY=""
# EMAIL_SENDER="hello@openpanel.dev"

# Option B - SMTP (used first when SMTP_HOST is present, even if RESEND_API_KEY is also set)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_SENDER="hello@openpanel.dev"

# GENERIC OIDC / SSO (optional)
# The callback is hosted by the API service, not the dashboard service.
# Local example: http://localhost:3333/oauth/oidc/callback
# Production example: https://api.example.com/oauth/oidc/callback
OIDC_ENABLED="false"
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=""
# Optional override; defaults to ${OIDC_ISSUER}/.well-known/openid-configuration
OIDC_DISCOVERY_URL=""
OIDC_DISPLAY_NAME="Single Sign-On"
# button | auto
OIDC_LOGIN_MODE="button"
# Hide local, Google and GitHub authentication when true.
OIDC_ONLY="false"
# Additional space- or comma-separated provider scopes.
OIDC_EXTRA_SCOPES=""
# Optional claim/value pair. Both must be set together.
OIDC_REQUIRED_CLAIM=""
OIDC_REQUIRED_VALUE=""
# Allow role-validated OIDC users to be created while public registration is locked.
OIDC_ALLOW_REGISTRATION="false"
# Disabled by default. Enable only for a controlled migration of existing accounts.
OIDC_ALLOW_EMAIL_LINKING="false"
