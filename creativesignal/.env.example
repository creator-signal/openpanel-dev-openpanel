# Generic OIDC / SSO. The callback is hosted by the API service.
# Local: http://localhost:48211/oauth/oidc/callback
# Production: https://replay-api.creatorsignal.me/oauth/oidc/callback
OIDC_ENABLED="true"
OIDC_ISSUER="https://auth.example.com"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:48211/oauth/oidc/callback"
# Optional override; defaults to ${OIDC_ISSUER}/.well-known/openid-configuration
OIDC_DISCOVERY_URL=""
OIDC_DISPLAY_NAME="Creator Signal"
# button | auto
OIDC_LOGIN_MODE="auto"
# Hide local, Google and GitHub authentication when true.
OIDC_ONLY="true"
# Additional space- or comma-separated provider scopes.
OIDC_EXTRA_SCOPES="urn:zitadel:iam:org:project:role:platform:operator"
# Both required-claim values must be set together.
OIDC_REQUIRED_CLAIM="urn:zitadel:iam:org:project:roles"
OIDC_REQUIRED_VALUE="platform:operator"
# Allow role-validated OIDC users to be created while public registration is locked.
OIDC_ALLOW_REGISTRATION="true"
# Enable only during a controlled migration of existing accounts.
OIDC_ALLOW_EMAIL_LINKING="false"
